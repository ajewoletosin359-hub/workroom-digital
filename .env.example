# Set your production URL (used for metadata, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form backend — set to a real endpoint (e.g. Formspree).
# Without this, the form falls back to opening the visitor's email client
# (ajewoletosin359@gmail.com) and says so clearly instead of faking success.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/[your-form-id]
